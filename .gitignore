# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# Local credentials and templates, including backend/.env, must stay off Git.
.env*

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# Documents stay local, except invented fixtures and the dummy invoice set.
*.pdf
*.xlsx
!fixtures/**/*.pdf
!fixtures/**/*.xlsx
!/data/dummy/**/*.pdf
!/data/dummy/**/*.xlsx
!/data/mock_invoice_dataset/**/*.pdf
!/data/mock_invoice_dataset/**/*.xlsx
/data/private/
/backend/runtime/

# anything real (client files, real lists) stays on this machine
*.private.*

# Python invoice processing and local document artifacts
__pycache__/
*.py[cod]
.venv/
.pytest_cache/
.ruff_cache/
*.egg-info/
/backend/artifacts/

# Generated from libarchive.js during install/build.
/public/archive/
